# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- LLM provider API keys (required to run the bid pool for real) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# GOOGLE_API_KEY or GEMINI_API_KEY both work, GOOGLE_API_KEY takes precedence
GOOGLE_API_KEY=
GEMINI_API_KEY=

# --- XRPL testnet wallets ---
# Leave blank and run `npm run setup:wallets` — it generates + faucet-funds
# four wallets and appends their seeds here. Never commit real seed values.
XRPL_SEED_AGENT=
XRPL_SEED_PROVIDER_OPENAI=
XRPL_SEED_PROVIDER_ANTHROPIC=
XRPL_SEED_PROVIDER_GEMINI=

# --- XRPL network ---
XRPL_NETWORK=wss://s.altnet.rippletest.net:51233

# --- Settlement ---
# channel = Payment Channel primary path (falls back to `payment` automatically on failure)
# payment = force discrete Payment-per-task for every settlement
SETTLEMENT_MODE=channel
# Illustrative fixed conversion rate, NOT a live oracle. Out of scope for a
# one-day build — see docs/architecture.md.
XRP_USD_RATE=0.50

# --- Safeguards ---
SESSION_SPEND_CAP_USD=2.00
PROVIDER_QUOTE_TIMEOUT_MS=8000

# --- App base URL ---
# Used by the orchestrator to call the provider adapter routes over real HTTP
# (so /quote's 402 is a genuine network round-trip). Leave blank locally —
# it defaults to http://localhost:3000. Set this explicitly for a deployed
# domain.
NEXT_PUBLIC_APP_URL=
